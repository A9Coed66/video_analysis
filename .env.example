# =============================================================================
# Voice Separator Web — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values before running the system.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set. Variables marked [OPTIONAL] have
# sensible defaults and can be omitted.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Hugging Face access token for pyannote diarization models.
# Obtain one at https://huggingface.co/settings/tokens
# If left empty the Pipeline service is disabled (POST /api/pipeline → 503).
HF_TOKEN=hf_xxxxx

# Comma-separated list of valid API keys for authenticating /api/* requests.
# Example: API_KEYS=key1,key2,key3
API_KEYS=changeme-key-1,changeme-key-2

# Redis connection URL used as Celery broker and job store.
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Optional — File & Job settings
# -----------------------------------------------------------------------------

# Maximum upload file size in bytes (default: 524288000 = 500 MB).
MAX_FILE_SIZE=524288000

# Hours before completed jobs (and their files) are automatically purged.
JOB_TTL_HOURS=24

# Comma-separated list of allowed CORS origins.
# Do NOT use wildcard "*" in production.
ALLOWED_ORIGINS=https://example.com

# -----------------------------------------------------------------------------
# Optional — Server
# -----------------------------------------------------------------------------

# Number of Uvicorn worker processes for the API server.
UVICORN_WORKERS=4

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional — Model checkpoint paths
# -----------------------------------------------------------------------------

# Directory containing DPRNN-TasNet model checkpoint files (container path).
DPRNN_CHECKPOINT_DIR=/models/dprnn

# Directory containing Pipeline model files (container path).
PIPELINE_MODEL_DIR=/models/pipeline

# Host paths for model directories (mounted into containers).
# These are the paths on the HOST machine where model files are stored.
DPRNN_HOST_DIR=./voice_separator/checkpoints_premium
PIPELINE_HOST_DIR=./pipeline/models

# -----------------------------------------------------------------------------
# Optional — GPU assignment
# -----------------------------------------------------------------------------

# GPU device index assigned to the DPRNN separation worker.
GPU_SEPARATION=0

# GPU device index assigned to the Pipeline worker.
GPU_PIPELINE=1

# -----------------------------------------------------------------------------
# Optional — Celery worker concurrency
# -----------------------------------------------------------------------------

# Number of concurrent tasks for the separation worker.
CELERY_SEPARATION_CONCURRENCY=1

# Number of concurrent tasks for the pipeline worker.
CELERY_PIPELINE_CONCURRENCY=1
